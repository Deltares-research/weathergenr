# R / IDE (local state)
.Rproj.user/
.Rhistory
.RData
.Renviron
.Rapp.history
.Ruserdata
.DS_Store

# Credentials / tokens
.httr-oauth

# Build artifacts
/*.Rcheck/
/*.tar.gz
*-Ex.R

# Quarto/knitr artifacts
vignettes/*_files/
vignettes/*.html
vignettes/.quarto/
*_cache/

# Scratch and generated results (one scratch dir at the project root)
.tmp/
/output/

# Vendored agent system (symlinks into ~/workspace/brain; regenerated by
# `brain refresh --agent-system`). AGENTS.md and CLAUDE.md stay tracked.
# `.github/agents/` holds generated Copilot role profiles; the rest of
# `.github/` (workflows) stays tracked.
/.claude/
/.codex/
/.agents/
/.github/agents/

# Misc local / manual
/tests/tests_manual/
*.utf8.md
*.knit.md
/doc/
/Meta/

# Dev-only root Markdown that pkgdown insists on rendering into the site.
# pkgdown globs every root *.md and has no ignore mechanism, so a site build
# recreates these; tools/build_site_tools.R deletes them afterwards and this is
# the backstop for a build that bypasses it. The sources at the repo root are
# tracked as normal -- only the rendered copies are ignored.
/docs/AGENTS.md
/docs/AGENTS.html
/docs/CLAUDE.md
/docs/CLAUDE.html
