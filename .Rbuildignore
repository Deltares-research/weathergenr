
# RStudio / project
^.*\.Rproj$
^\.Rproj\.user$
^\.Rprofile$

# Licenses / repo-only docs
^LICENSE\.md$

# Repo-only release policy (git-workflow ceremony + versioning adapter)
^\.git-workflow\.yml$

# devtools build artifacts
^doc$
^Meta$

# pkgdown / website
^pkgdown$
^docs$
^_pkgdown\.yml$

# GitHub metadata
^\.github$

# README sources not needed in build
^README\.Rmd$
^README\.qmd$
^README_files$
^README\.html$

# Quarto build helpers / caches
^.*_cache$
^\.build_quarto_vignettes\.R$
^vignettes/.*_files$
^vignettes/.*\.html$
^vignettes/\.quarto$
# Quarto's freeze cache. Tracked in Git on purpose -- committing it is what
# stops the vignettes re-executing the generator on every build -- but it must
# not ship in the tarball, where R CMD check reports it as vignette files with
# no rendered output. Distinct from vignettes/.quarto above: both exist.
^vignettes/_freeze$

# Optional repo-only tools folder
^tools$

# Development process tree and scratch (repo-only, never shipped)
^dev$
^\.tmp$
^\.lintr$

# Optional: exclude large internal material inside inst/
^inst/docs$
^inst/examples$
^inst/misc$
^inst/extcode$

# OAuth token cache (should also be in .gitignore)
^\.httr-oauth$

# Codex rules (dev-only)
^codex_rules\.txt$
^codex_safe\.sh$

^output$

# Agent instructions / vendored agent system (dev-only)
^\.claude$
^\.codex$
^\.agents$
^CLAUDE\.md$
^AGENTS\.md$
